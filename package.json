{
  "name": "lcp-games-stats",
  "version": "1.0.0",
  "description": "Display and tracks my games stats",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "nodemon watch server.js",
    "test": "node --test",
    "coverage": "c8 --reporter=lcov npm test",
    "build:css": "sass public/css/style.scss public/css/style.css",
    "watchscss": "npx sass --watch public/css/style.scss public/css/style.css",
    "startall": "conc 'npm:watchscss' 'npm:start'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@popperjs/core": "^2.11.8",
    "axios": "^1.7.7",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "c8": "^8.0.0",
    "concurrently": "^10.0.3",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "sass": "^1.79.0"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test/**",
      "**/docs/**"
    ],
    "delay": 2500
  }
}
